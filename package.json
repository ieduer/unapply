{
  "name": "unapply",
  "private": true,
  "version": "1.0.0",
  "description": "你一定不考哪所大學 — 用減法從教育部 2026 普通高校名單中劃掉不能忍的那批",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:schools": "node scripts/build_official_schools.mjs",
    "data:github-profiles": "node scripts/extract_github_school_profiles.mjs",
    "data:laosheng-profiles": "node scripts/extract_laosheng_school_profiles.mjs",
    "data:campus-extract": "node scripts/extract_campus_locations.mjs",
    "data:admission": "node scripts/build_admission_channels.mjs",
    "data:research": "node scripts/build_admission_channels.mjs && node scripts/build_research_data.mjs && node scripts/build_campus_research.mjs && tsx scripts/export_runtime_payloads.ts",
    "data:runtime": "tsx scripts/export_runtime_payloads.ts",
    "data:gras": "node scripts/fetch_gras_rankings.mjs --year 2026",
    "data:gras-geo": "node scripts/geocode_gras_institutions.mjs --year 2026",
    "data:gras-websites": "node scripts/verify_institution_websites.mjs --year 2026",
    "data:atlas": "node scripts/build_world_atlas.mjs",
    "data:programs": "node scripts/build_programs_layer.mjs",
    "data:s1-fetch": "node scripts/fetch_s1_sources.mjs",
    "data:s1-build": "node scripts/build_s1_programs.mjs",
    "audit:s1": "node scripts/audit_s1_programs.mjs",
    "audit:questions": "node scripts/audit_question_rules.mjs",
    "audit:values": "tsx scripts/audit_dimension_values.mjs",
    "audit:data": "tsx scripts/audit_data_coverage.mjs",
    "build": "npm run data:tiers && npm run data:runtime && npm run data:atlas && npm run data:programs && npm run data:hkmotw && npm run data:joint && npm run data:overseas && npm run data:origins && npm run data:i18n && tsc -b && vite build",
    "lint": "eslint .",
    "test:evidence": "node --experimental-strip-types --test tests/learning-evidence.test.ts",
    "test:filters": "tsx --test tests/admission-channel.test.ts tests/evidence-threshold.test.ts tests/filter-validity.test.ts",
    "test:trusted": "tsx --test tests/trusted-aplus-*.test.ts",
    "test:theme": "tsx --test tests/theme-contrast.test.ts",
    "test:atlas": "tsx --test tests/world-atlas.test.ts",
    "test:s1": "tsx --test tests/s1-programs.test.ts",
    "check:shared-ui": "node scripts/check_shared_ui.mjs",
    "preview": "vite preview",
    "pages:deploy": "npm run build && bash /Users/ylsuen/CF/scripts/git-deploy-gate.sh && npx wrangler pages deploy dist --project-name unapply --branch master --commit-dirty=false",
    "prepages:deploy": "bash /Users/ylsuen/CF/scripts/git-deploy-gate.sh",
    "data:hkmotw": "node scripts/build_hkmotw_pool.mjs",
    "test:hkmotw": "tsx --test tests/hkmotw-pool.test.ts",
    "data:joint-fetch": "node scripts/fetch_joint_programs.mjs",
    "data:joint-build": "node scripts/build_joint_programs.mjs",
    "data:joint": "node scripts/build_joint_layer.mjs",
    "test:joint": "tsx --test tests/joint-programs.test.ts",
    "data:overseas": "node scripts/build_overseas_layer.mjs",
    "test:overseas": "tsx --test tests/overseas-layer.test.ts",
    "data:i18n": "node scripts/build_i18n.mjs",
    "test:i18n": "tsx --test tests/i18n.test.ts",
    "data:origins": "node scripts/build_origin_layer.mjs",
    "test:origins": "tsx --test tests/origins.test.ts",
    "data:tiers": "node scripts/build_authority_tiers.mjs",
    "audit:links": "node scripts/check_links.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@e965/xlsx": "^0.20.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wrangler": "^4.100.0"
  },
  "engines": {
    "node": "24.18.0"
  }
}
